# Copy to .env (gitignored). Laptop only. On the VM these already exist as env vars.
WANDB_API_KEY=            # wandb.ai/authorize, from the account the organizers credited
WANDB_TEAM=               # your W&B entity (username or team name)
WANDB_PROJECT=linger
LINGER_MODEL=             # leave blank, then run: make models   and paste one id here
LINGER_LLM=1              # 0 = rules only, no W&B calls
LINGER_WEAVE=1            # 0 = no Weave tracing
LINGER_SEARCH=local       # vss only on the VM, once vss_search is wired
